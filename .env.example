# Vero website environment variables.
# Copy to .env.local for development, configure on Railway for production.

# ─────────────────────────────────────────────────────────────────
# STRIPE (live mode in production, test mode for dev)
# ─────────────────────────────────────────────────────────────────

# Server-only — never expose to client
STRIPE_SECRET_KEY=sk_test_...

# Publishable key — safe for client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs from Stripe dashboard (monthly + yearly per tier)
STRIPE_PRICE_LITE=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_MAX=price_...
STRIPE_PRICE_LITE_YEARLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_MAX_YEARLY=price_...

# ─────────────────────────────────────────────────────────────────
# UPGRADE LINK SIGNING
# ─────────────────────────────────────────────────────────────────
# Shared secret between the WhatsApp service (signer) and the
# website (verifier). Generate with: openssl rand -hex 32
# MUST match the same secret in the WhatsApp service env.
UPGRADE_TOKEN_SECRET=

# ─────────────────────────────────────────────────────────────────
# URLs
# ─────────────────────────────────────────────────────────────────
# Public site URL — used for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL=https://vero-lab.com
